# Copy to .env and fill in. Optional keys are commented out; uncomment to set them. Never commit .env: it holds signing keys.
# See the README's Configuration section for what each value does.

# Listener. XMPP over WebSocket shares PORT; XMPP_PORT is raw TCP XMPP (default 60002).
PORT=
# HOST=
# XMPP_PORT=

# SQLite database file. Startup backs it up next to itself before migrating it.
DB_FILENAME=

# APIKEY, or NONE for local development (ignored when NODE_ENV=production).
AUTH_MODE=
AUTH_SIGNING_PRIVKEY_B64=
AUTH_SIGNING_PUBKEY_B64=
# OPEN, INVITECODE or NONE.
REGISTRATION_MODE=

# DEPLOYSERVER or DISABLED.
MATCHMAKING_MODE=
DEPLOYSERVER_URL=
QOS_TARGET_URL=

# The 1.12.0 client build, its store offer format, and new characters starting
# in Ramsgate instead of the tutorial island.
TARGET_CHANGELIST=392819
TARGET_BUILD_ID=392819_rel-1.12.0_shipping
STORE_OFFER_FORMAT=prices
SKIP_FTUE=true

# Hunt Pass. HUNT_PASS_PREMIUM_MODE is entitlement (default) or free.
ACTIVE_HUNT_PASS=season19
# HUNT_PASS_PREMIUM_MODE=

# The 1.12.0 game data in the repository, relative to this folder
# (see data/1.12/README.md).
STORE_DATA_DIR=../data/1.12/store
HUNT_PASS_SEASONS_DIR=../data/1.12/huntpass
HUNT_PASS_LIBRARY_FILE=../data/1.12/huntpass-library.json
ESCALATION_SEASONS_FILE=../data/1.12/escalation/seasons.json
LINKED_SLAYER_REWARDS_FILE=../data/1.12/linked-slayer/linked_slayer_rewards.json
CHALLENGE_REWARDS_FILE=../data/1.12/challenges/challenge_rewards.json
SEASONAL_EVENTS_FILE=../data/1.12/events/seasonal_events.json

# Logging. WIRE_CAPTURE=true records requests to selected routes (secrets redacted).
# LOG_LEVEL=
# WIRE_CAPTURE=
