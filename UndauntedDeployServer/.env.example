# Copy to .env and fill in. Optional keys are commented out; uncomment to set them. Never commit .env: it holds the metagame API key.
# See the README's Configuration section for what each value does.

# Listener, and the address players are sent to.
PORT=
# HOST=
MY_IP=

# UDP ports for world servers.
PORT_RANGE_BEGIN=
PORT_RANGE_END=

# The game executable used to run world servers.
GAMESERVER_BINARY_PATH=
SECONDS_TO_WAIT_BETWEEN_GAMESERVER_STARTUP=

# How world servers reach the metagame.
METAGAME_ADDRESS=
METAGAME_API_KEY=

# Hunt and Trials tables for the client being served (outside the repository).
# Leave unset to use the bundled 1.4.4 tables.
# HUNT_DATA_DIR=

# Watchdog and logging.
# ENABLE_WATCHDOG=
# GAMESERVER_LOG_DIR=
# GAMESERVER_LOG_CMDS=
# LOG_LEVEL=
